    "Açık kurallar" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rules on"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık kurallar"
          }
        }
      }
    },
    "App Group bulunamadı. Kurallar kaydedilemez, filtre sadece varsayılan kurallarla çalışır. Xcode'da hedeflerin Signing ayarlarını kontrol et." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Group not found. Rules can't be saved, so the filter only uses the default rules. Check the targets' Signing settings in Xcode."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Group bulunamadı. Kurallar kaydedilemez, filtre sadece varsayılan kurallarla çalışır. Xcode'da hedeflerin Signing ayarlarını kontrol et."
          }
        }
      }
    },
    "Ayarlar uygulamasını aç." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the Settings app."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar uygulamasını aç."
          }
        }
      }
    },
    "Bahis ve kredi reklamı" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betting and loan ads"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahis ve kredi reklamı"
          }
        }
      }
    },
    "Bahis, kredi ve dolandırıcılık mesajlarını Gereksiz klasörüne ayırır. Doğrulama kodlarını ve kargo bildirimlerini kendi klasörlerine koyar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves betting, loan and scam messages to Junk. Puts verification codes and delivery updates in their own folders."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahis, kredi ve dolandırıcılık mesajlarını Gereksiz klasörüne ayırır. Doğrulama kodlarını ve kargo bildirimlerini kendi klasörlerine koyar."
          }
        }
      }
    },
    "Bahisçiler gerçek firmaların gönderici adlarını kullanabiliyor. Engellersen o firmanın gerçek mesajları da gelmez." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betting spammers can use real companies' sender names. If you block it, that company's real messages won't come through either."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahisçiler gerçek firmaların gönderici adlarını kullanabiliyor. Engellersen o firmanın gerçek mesajları da gelmez."
          }
        }
      }
    },
    "Başla" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get Started"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başla"
          }
        }
      }
    },
    "Bilinmeyen ve Spam bölümüne gir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to Unknown & Spam."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilinmeyen ve Spam bölümüne gir."
          }
        }
      }
    },
    "Bir numarayı rehberden silmek onu filtreye sokmaz: o numaraya daha önce cevap yazdıysan iOS onu tanıdık saymaya devam eder." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting a number from your contacts doesn't send it to the filter: if you have replied to that number before, iOS still treats it as known."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir numarayı rehberden silmek onu filtreye sokmaz: o numaraya daha önce cevap yazdıysan iOS onu tanıdık saymaya devam eder."
          }
        }
      }
    },
    "Birden fazla kural eşleşirse öncelik: İzin ver › Gereksiz › Promosyonlar › İşlemler." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If several rules match, the order is: Allow › Junk › Promotions › Transactions."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birden fazla kural eşleşirse öncelik: İzin ver › Gereksiz › Promosyonlar › İşlemler."
          }
        }
      }
    },
    "Bitti" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Done"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitti"
          }
        }
      }
    },
    "Bu adresi içeren tüm mesajlar Gereksiz'e gider. Bilinen bir siteyse (ör. instagram.com) işaretleme." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every message containing this address goes to Junk. Don't select well-known sites (e.g. instagram.com)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu adresi içeren tüm mesajlar Gereksiz'e gider. Bilinen bir siteyse (ör. instagram.com) işaretleme."
          }
        }
      }
    },
    "Bu ifade mesajda geçmiyor." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This phrase isn't in the message."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ifade mesajda geçmiyor."
          }
        }
      }
    },
    "Bu kural gelişmiş bir desen kullanıyor. Görmek veya değiştirmek için Gelişmiş'i aç." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This rule uses an advanced pattern. Open Advanced to see or change it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kural gelişmiş bir desen kullanıyor. Görmek veya değiştirmek için Gelişmiş'i aç."
          }
        }
      }
    },
    "Bu kurallar zaten listende var." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These rules are already in your list."
