{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ göndericisini engelle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Block sender %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ göndericisini engelle"
          }
        }
      }
    },
    "%lld" : {
      "shouldTranslate" : false
    },
    "%lld kural açık" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld rule on"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld rules on"
