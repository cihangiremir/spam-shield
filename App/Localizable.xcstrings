            "state" : "translated",
            "value" : "%lld kural açık"
          }
        }
      }
    },
    "%lld kural eklendi. Benzer mesajlar artık Gereksiz'e gidecek." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld rule added. Similar messages will now go to Junk."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld rules added. Similar messages will now go to Junk."
                }
              }
            }
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld kural eklendi. Benzer mesajlar artık Gereksiz'e gidecek."
