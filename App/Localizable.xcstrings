    "Filtre tamamen iPhone'unda çalışır, hiçbir mesaj bir sunucuya gönderilmez. Rehberindeki kişilerden, daha önce cevap yazdığın numaralardan gelen mesajlar ve iMessage'lar filtreye hiç gelmez." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The filter runs entirely on your iPhone; no message is sent to a server. Messages from your contacts, from numbers you have replied to and iMessages never reach the filter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtre tamamen iPhone'unda çalışır, hiçbir mesaj bir sunucuya gönderilmez. Rehberindeki kişilerden, daha önce cevap yazdığın numaralardan gelen mesajlar ve iMessage'lar filtreye hiç gelmez."
          }
        }
      }
    },
    "Filtre tamamen iPhone'unda çalışır. Mesajların hiçbir sunucuya gönderilmez." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The filter runs entirely on your iPhone. Your messages are never sent to a server."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtre tamamen iPhone'unda çalışır. Mesajların hiçbir sunucuya gönderilmez."
          }
        }
      }
    },
    "Filtre, Ayarlar'da Spam Shield seçili değilse çalışmaz." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The filter only works when Spam Shield is selected in Settings."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtre, Ayarlar'da Spam Shield seçili değilse çalışmaz."
          }
        }
      }
    },
    "Filtrelenen mesajlar nereye gider" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where filtered messages go"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrelenen mesajlar nereye gider"
          }
        }
      }
    },
    "Filtrelenen mesajlar silinmez. Mesajlar uygulamasında sol üstteki Filtreler menüsünden Gereksiz, Promosyonlar ve İşlemler klasörlerinde görebilirsin. Bu mesajlar için bildirim gelmez." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtered messages aren't deleted. In Messages, open the Filters menu at the top left to see them in Junk, Promotions and Transactions. You don't get notifications for them."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrelenen mesajlar silinmez. Mesajlar uygulamasında sol üstteki Filtreler menüsünden Gereksiz, Promosyonlar ve İşlemler klasörlerinde görebilirsin. Bu mesajlar için bildirim gelmez."
          }
        }
      }
    },
