        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu mesajlar silinmez; Mesajlar'daki Promosyonlar ve İşlemler klasörlerine ayrılır."
          }
        }
      }
    },
    "Büyük/küçük harf, Türkçe karakterler ve fazla boşluklar dikkate alınmaz." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
