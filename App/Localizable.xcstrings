            "value" : "Temizle"
          }
        }
      }
    },
    "Tüm kurallar silinip varsayılanlar yüklensin mi?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete all rules and load the defaults?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm kurallar silinip varsayılanlar yüklensin mi?"
          }
        }
      }
    },
    "Uygulamalar › Mesajlar'a gir (iOS 17'de doğrudan Mesajlar)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to Apps › Messages (on iOS 17, just Messages)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamalar › Mesajlar'a gir (iOS 17'de doğrudan Mesajlar)."
          }
        }
      }
    },
    "Varsayılan olarak kapalı. Açarsan bazı gerçek mesajlar da Gereksiz'e düşebilir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. If you turn them on, some real messages may go to Junk too."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan olarak kapalı. Açarsan bazı gerçek mesajlar da Gereksiz'e düşebilir."
          }
        }
      }
    },
    "Varsayılanlara dön" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset to Defaults"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılanlara dön"
          }
        }
      }
    },
    "Vazgeç" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vazgeç"
          }
        }
      }
    },
    "Yeni kural" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New Rule"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni kural"
          }
        }
      }
    },
    "Filtrelenen mesajlar silinmez, bildirim de gelmez. Mesajlar'da sol üstteki Filtreler menüsünden Gereksiz, Promosyonlar ve İşlemler klasörlerinde görebilirsin." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtered messages aren't deleted and don't notify you. In Messages, open the Filters menu at the top left to see them in Junk, Promotions and Transactions."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrelenen mesajlar silinmez, bildirim de gelmez. Mesajlar'da sol üstteki Filtreler menüsünden Gereksiz, Promosyonlar ve İşlemler klasörlerinde görebilirsin."
          }
        }
      }
    },
    "Promosyonlar veya İşlemler klasörü görünmüyorsa o kuralları Gereksiz'e yönlendir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you don't see the Promotions or Transactions folder, send those rules to Junk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promosyonlar veya İşlemler klasörü görünmüyorsa o kuralları Gereksiz'e yönlendir."
          }
        }
      }
    },
    "Sadece tanımadığın göndericilerden gelen SMS'ler. Rehberindeki kişiler, cevap yazdığın numaralar ve iMessage'lar filtrelenmez." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only SMS from unknown senders. Your contacts, numbers you have replied to and iMessages aren't filtered."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadece tanımadığın göndericilerden gelen SMS'ler. Rehberindeki kişiler, cevap yazdığın numaralar ve iMessage'lar filtrelenmez."
          }
        }
      }
    },
    "Cevap yazdığın bir numara rehberden silinse de tanıdık sayılır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A number you have replied to still counts as known after you delete it from your contacts."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cevap yazdığın bir numara rehberden silinse de tanıdık sayılır."
          }
        }
      }
    },
    "Filtre tamamen iPhone'unda çalışır, mesajların hiçbir yere gönderilmez. İnternet sadece kural listesini güncellemek için kullanılır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The filter runs entirely on your iPhone; your messages are never sent anywhere. The app only goes online to update the rule list."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtre tamamen iPhone'unda çalışır, mesajların hiçbir yere gönderilmez. İnternet sadece kural listesini güncellemek için kullanılır."
          }
        }
      }
    },
    "Filtrenin çalışması için Ayarlar'da Spam Shield'ı seç." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select Spam Shield in Settings to turn the filter on."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrenin çalışması için Ayarlar'da Spam Shield'ı seç."
          }
        }
      }
    },
    "Yeni kurallar otomatik indirilir. Değiştirdiğin kurallar korunur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New rules are downloaded automatically. Rules you changed are kept."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni kurallar otomatik indirilir. Değiştirdiğin kurallar korunur."
          }
        }
      }
    },
    "Bahis, kredi ve dolandırıcılık mesajlarını Gereksiz'e ayırır. Kodları ve kargo bildirimlerini kendi klasörlerine koyar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves betting, loan and scam messages to Junk. Puts codes and delivery updates in their own folders."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahis, kredi ve dolandırıcılık mesajlarını Gereksiz'e ayırır. Kodları ve kargo bildirimlerini kendi klasörlerine koyar."
          }
        }
      }
    },
    "Filtre tamamen iPhone'unda çalışır. Hiçbir mesaj bir sunucuya gönderilmez." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The filter runs entirely on your iPhone. No message is ever sent to a server."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtre tamamen iPhone'unda çalışır. Hiçbir mesaj bir sunucuya gönderilmez."
          }
        }
      }
    },
    "Rehberindeki kişiler, cevap yazdığın numaralar ve iMessage'lar filtreye hiç uğramaz. Buradaki sonuç onlar için geçerli değildir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your contacts, numbers you have replied to and iMessages never reach the filter. The result here doesn't apply to them."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rehberindeki kişiler, cevap yazdığın numaralar ve iMessage'lar filtreye hiç uğramaz. Buradaki sonuç onlar için geçerli değildir."
          }
        }
      }
    },
    "Mesajlar'da mesaja uzun bas › Kopyala, sonra buraya yapıştır." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Messages, touch and hold the message › Copy, then paste it here."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesajlar'da mesaja uzun bas › Kopyala, sonra buraya yapıştır."
          }
        }
      }
    },
    "Kelimelere dokunarak ifade oluştur. Kısa, yaygın ifadeler normal mesajları da engelleyebilir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap words to build a phrase. Short, common phrases can block normal messages too."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelimelere dokunarak ifade oluştur. Kısa, yaygın ifadeler normal mesajları da engelleyebilir."
          }
        }
      }
    },
    "Öğrenen filtre kapalı. Kurallar sekmesinden açabilirsin." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The learning filter is off. You can turn it on in the Rules tab."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğrenen filtre kapalı. Kurallar sekmesinden açabilirsin."
          }
        }
      }
    },
    "Hazır kural silinemez, kapatılabilir. Düzenlersen güncellemeler bu kuralı değiştirmez." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built-in rules can't be deleted, only turned off. Once you edit one, updates no longer change it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazır kural silinemez, kapatılabilir. Düzenlersen güncellemeler bu kuralı değiştirmez."
          }
        }
      }
    },
    "Bu kural gelişmiş bir desen kullanıyor. Gelişmiş'ten görebilirsin." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This rule uses an advanced pattern. You can see it under Advanced."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kural gelişmiş bir desen kullanıyor. Gelişmiş'ten görebilirsin."
          }
        }
      }
    }
  },
  "version" : "1.0"
}